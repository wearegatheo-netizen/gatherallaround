# Cloudflare Pages 응답 헤더
# 폰트는 파일명에 내용이 고정돼 있으므로 1년 불변 캐시.
# 폰트 교체 시 반드시 파일명을 바꿀 것 (예: -latin.v2.woff2) — 안 그러면 캐시가 갱신되지 않음.
/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# vendor 라이브러리도 버전을 파일명에 박아 불변 캐시 (예: qrcode.v1.4.4.js)
/vendor/*
  Cache-Control: public, max-age=31536000, immutable

# 와펜 기본 세트 이미지 — 캔버스(crossOrigin=anonymous)에 그리므로 www·pages.dev 등 다른 출처에서도 CORS 허용. 재생성 가능하므로 7일 캐시.
/wappen/seed/*
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=604800
